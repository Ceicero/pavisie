{
  "name": "@pavisie/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifests": "./src/manifests.ts",
    "./sdk": "./src/sdk/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.js src",
    "test": "vitest run --passWithNoTests",
    "export:commands": "tsx scripts/export-commands.ts",
    "export:permissions": "tsx scripts/export-permissions.ts",
    "registry:sanity": "tsx scripts/registry-sanity.ts",
    "check:i18n": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "discord-api-types": "^0.37.114",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "pino": "^9.6.0",
    "luxon": "^3.5.0",
    "cron-parser": "^4.9.0",
    "@pavisie/core": "workspace:*",
    "@pavisie/database": "workspace:*",
    "@pavisie/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/luxon": "^3.4.2",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.19.2"
  }
}
