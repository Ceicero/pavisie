// ---------------------------------------------------------------------------
// Donations (public website; not tenant-scoped) — see ARCHITECTURE.md §18.
// Append-only status transitions (PENDING -> PAID | FAILED | EXPIRED). Never
// purged by the retention job (see src/retention.ts). Stores no personal data.
// ---------------------------------------------------------------------------

model Donation {
  id                    String         @id @default(cuid())
  stripeSessionId       String         @unique
  stripePaymentIntentId String?
  amountCents           Int
  currency              String         @default("usd")
  status                DonationStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  paidAt                DateTime?
  updatedAt             DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Developer reports — guild admin → bot developer support channel (`admin`
// plugin's `/pavisie report`). Only what the admin typed plus unavoidable
// routing metadata is ever stored here; never message history or member lists.
// ---------------------------------------------------------------------------

model DeveloperReport {
  id         String                @id @default(cuid())
  guildId    String
  guild      Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildName  String
  senderId   String
  senderTag  String
  kind       DeveloperReportKind
  subject    String
  body       String
  botVersion String
  status     DeveloperReportStatus @default(OPEN)
  /// Internal-only notes for the bot developer (never shown to the reporting guild).
  notes      String?
  handledAt  DateTime?
  handledBy  String?
  createdAt  DateTime              @default(now())

  @@index([guildId])
  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Enforcer — policy-driven, hands-off moderation. See ARCHITECTURE.md §19.
// ---------------------------------------------------------------------------

model EnforcerPolicy {
  id               String            @id @default(cuid())
  guildId          String
  guild            Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name             String
  description      String
  enabled          Boolean           @default(true)
  severity         PolicySeverity    @default(MEDIUM)
  /// [{type:'keyword'|'phrase'|'regex'|'link_domain'|'invite'|'mention_count'|'attachment_ext'|'ai_category', value: string|string[]|number, caseSensitive?: bool, wholeWord?: bool}]
  matchers         Json
  channelIds       String[]
  exemptRoleIds    String[]
  exemptChannelIds String[]
  suggestedAction  EnforcerDecision?
  createdBy        String
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  records EnforcerRecord[]

  @@index([guildId, enabled])
  @@index([guildId])
}

model EnforcerRecord {
  id              String              @id @default(cuid())
  guildId         String
  guild           Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  recordNumber    Int
  kind            EnforcerRecordKind
  status          EnforcerFlagStatus?
  userId          String
  channelId       String?
  messageId       String?
  messageJumpUrl  String?
  policyId        String?
  policy          EnforcerPolicy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyName      String?
  matcherSummary  String?
  riskScore       Float?
  aiExplanation   String?
  excerpt         String?
  contextSnapshot Json?
  source          EnforcerSource
  flaggedBy       String?
  decision        EnforcerDecision?
  decidedBy       String?
  decidedAt       DateTime?
  decisionReason  String?
  durationMs      Int?
  caseId          String?
  case            ModerationCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  parentRecordId  String?
  ledgerMessageId String?
  flagMessageId   String?
  createdAt       DateTime            @default(now())

  @@unique([guildId, recordNumber])
  @@index([guildId, userId, createdAt])
  @@index([guildId, kind, createdAt])
  @@index([guildId, status])
  @@index([guildId, policyId])
}

// ---------------------------------------------------------------------------
// Game stats — opt-in Steam leaderboards (`gamestats` plugin). Steam-only (no public API exists for
// console platforms). Data minimization mirrors Birthday: only what's needed to render a leaderboard/stat
// card is stored, latest snapshot only (no history), and linking/unlinking is member self-service and
// deliberately NOT audited (same reasoning as birthdays).
// ---------------------------------------------------------------------------

/// One linked external game account per member per guild per provider (opt-in, self-service via `/dbd link`
/// and `/dbd unlink`). Stores only the external account id and a cached display name — never anything else
/// from the provider's profile.
model GameAccountLink {
  id           String              @id @default(cuid())
  guildId      String
  guild        Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId       String
  provider     GameAccountProvider
  externalId   String // SteamID64 for provider = STEAM
  externalName String? // cached persona name, refreshed alongside stats
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([guildId, userId, provider])
  // Cross-member duplicate guard: the same external account (e.g. one Steam profile) can only be linked once
  // per guild, full stop — not once per member. `/dbd link` checks this proactively (friendly reply) and this
  // constraint is the actual race-safe guarantee (see `commands/dbd.ts`'s `handleLink` P2002 catch).
  @@unique([guildId, provider, externalId])
  @@index([guildId])
}

/// Latest curated stat snapshot per member per game per guild — only the stat keys the game descriptor
/// displays, never the provider's full stats payload. No history: each refresh overwrites the row.
model GameStatSnapshot {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  game      String // game descriptor key, e.g. 'dbd'
  stats     Json // { statId: number } — curated keys only, per the game descriptor
  fetchedAt DateTime
  lastError String? // e.g. 'private', surfaced back to the member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, game])
  @@index([guildId, game])
}
