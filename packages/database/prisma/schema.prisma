// Pavisie — Prisma schema. See docs/ARCHITECTURE.md §8 for conventions.
// Every tenant table carries `guildId` + `@@index([guildId])`. Timestamps are
// `createdAt @default(now())` / `updatedAt @updatedAt` unless a model is an
// append-only log (createdAt only). Soft delete via `deletedAt DateTime?` on
// ModerationCase, Ticket, RolePanel, AutomodRule, Suggestion, WebhookEndpoint,
// IntegrationConnection (and a few related child tables, per model).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ModerationCaseType {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
  SOFTBAN
  PURGE
  LOCK
  UNLOCK
  SLOWMODE
  NICK
  ROLE_ADD
  ROLE_REMOVE
  QUARANTINE
  NOTE
}

enum ActionSource {
  BOT
  DASHBOARD
  AUTOMOD
  SYSTEM
}

enum AppealStatus {
  PENDING
  ACCEPTED
  DENIED
}

enum AutomodRuleType {
  MESSAGE_FREQUENCY
  DUPLICATE_MESSAGES
  MENTION_SPAM
  INVITE_LINKS
  SCAM_LINKS
  REGEX_FILTER
  WORD_FILTER
  CAPS
  REPEATED_CHARS
  ATTACHMENTS
  NSFW_ENFORCEMENT
  ACCOUNT_AGE
  RAID_DETECTION
}

enum AutomodReviewStatus {
  NONE
  PENDING
  CONFIRMED
  FALSE_POSITIVE
}

enum ActorType {
  USER
  SYSTEM
}

enum AuditSource {
  BOT
  DASHBOARD
  SYSTEM
}

enum TicketMode {
  CHANNEL
  THREAD
}

enum TicketStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum RolePanelStyle {
  BUTTONS
  SELECT
  REACTIONS
}

enum VerificationMethod {
  BUTTON
  MODAL
  CAPTCHA
  STAFF
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  DENIED
  IMPLEMENTED
  CONSIDERING
}

enum RsvpStatus {
  GOING
  MAYBE
  DECLINED
}

enum TagTriggerMode {
  NONE
  EXACT
  CONTAINS
  STARTS_WITH
}

// GITHUB, NOTION and STRIPE (the guild-facing connector, not donations) were removed as offered/connectable
// providers on 2026-09-02 (Brandon's decision) — kept here, unused, only so historical `IntegrationConnection`
// rows with these values keep reading correctly. Never re-add a provider file/registry entry for them without
// also deciding whether these enum values should come back into use. See docs/ARCHITECTURE.md §18a.
enum IntegrationProvider {
  TWITCH
  YOUTUBE
  GITHUB
  REDDIT
  STEAM
  GOOGLE_CALENDAR
  MICROSOFT_CALENDAR
  NOTION
  STRIPE
  OPENAI
  ANTHROPIC
  GENERIC_WEBHOOK
  INSTAGRAM
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

/// Chat-privilege ladder used by TwitchChatCommand.minLevel (badges on the EventSub chat event map to this).
enum TwitchChatLevel {
  EVERYONE
  SUBSCRIBER
  VIP
  MODERATOR
  BROADCASTER
}

/// What a channel-point reward redemption triggers (TwitchChatReward.action).
enum TwitchRewardActionKind {
  SOUND
  TTS
  CHAT
  DISCORD
}

enum DataRequestType {
  EXPORT
  DELETE
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum DeveloperReportKind {
  BUG
  FEEDBACK
  QUESTION
}

enum DeveloperReportStatus {
  OPEN
  HANDLED
}

enum PolicySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EnforcerRecordKind {
  FLAG
  DECISION
  APPEAL_OPENED
  APPEAL_DECIDED
  NOTE
}

enum EnforcerFlagStatus {
  PENDING
  ACTIONED
  DISMISSED
  EXPIRED
}

enum EnforcerSource {
  AUTO
  MANUAL
  AI_ASSIST
  DASHBOARD
}

enum EnforcerDecision {
  WARN
  TIMEOUT
  MUTE
  UNMUTE
  KICK
  BAN
  DISMISS
}

/// Steam-only in v1 (no public API exists for console platforms) — see the `gamestats` plugin.
enum GameAccountProvider {
  STEAM
}

// ---------------------------------------------------------------------------
// Guild + core config
// ---------------------------------------------------------------------------

model Guild {
  id              String    @id
  name            String
  iconHash        String?
  ownerId         String
  botPresent      Boolean   @default(true)
  memberCount     Int?
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  preferredLocale String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  config                 GuildConfig?
  pluginStates           PluginState[]
  pluginConfigs          PluginConfig[]
  moderationCases        ModerationCase[]
  moderationWarnings     ModerationWarning[]
  moderationNotes        ModerationNote[]
  moderationAppeals      ModerationAppeal[]
  automodRules           AutomodRule[]
  automodEvents          AutomodEvent[]
  auditLogs              AuditLog[]
  logEvents              LogEvent[]
  tickets                Ticket[]
  ticketPanels           TicketPanel[]
  rolePanels             RolePanel[]
  roleGroups             RoleGroup[]
  memberRoleSnapshots    MemberRoleSnapshot[]
  verificationRequests   VerificationRequest[]
  onboardingProgress     OnboardingProgress[]
  scheduledJobs          ScheduledJob[]
  reminders              Reminder[]
  scheduledAnnouncements ScheduledAnnouncement[]
  giveaways              Giveaway[]
  polls                  Poll[]
  suggestions            Suggestion[]
  starboardEntries       StarboardEntry[]
  tempVoiceChannels      TempVoiceChannel[]
  communityEvents        CommunityEvent[]
  tags                   Tag[]
  stickyMessages         StickyMessage[]
  birthdays              Birthday[]
  levelProfiles          LevelProfile[]
  levelRewards           LevelReward[]
  reputationEvents       ReputationEvent[]
  economyAccounts        EconomyAccount[]
  economyTransactions    EconomyTransaction[]
  afkStatuses            AfkStatus[]
  integrationConnections IntegrationConnection[]
  webhookEndpoints       WebhookEndpoint[]
  twitchChatChannels     TwitchChatChannel[]
  twitchChatCommands     TwitchChatCommand[]
  twitchChatTimers       TwitchChatTimer[]
  twitchChatRewards      TwitchChatReward[]
  dataRetentionPolicy    DataRetentionPolicy?
  dataRequests           DataRequest[]
  dataExportBlobs        DataExportBlob[]
  aiUsages               AiUsage[]
  analyticsDaily         GuildAnalyticsDaily[]
  enforcerPolicies       EnforcerPolicy[]
  enforcerRecords        EnforcerRecord[]
  developerReports       DeveloperReport[]
  gameAccountLinks       GameAccountLink[]
  gameStatSnapshots      GameStatSnapshot[]
}

model GuildConfig {
  id                    String    @id @default(cuid())
  guildId               String    @unique
  guild                 Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  locale                String    @default("en")
  timezone              String    @default("UTC")
  adminRoleIds          String[]
  modRoleIds            String[]
  helperRoleIds         String[]
  modLogChannelId       String?
  staffChannelId        String?
  appealsChannelId      String?
  fastActions           Boolean   @default(false)
  dataCollectionEnabled Boolean   @default(false)
  logMessageContent     Boolean   @default(false)
  dmOnModeration        Boolean   @default(true)
  setupCompletedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([guildId])
}

// ---------------------------------------------------------------------------
// Plugin system
// ---------------------------------------------------------------------------

model PluginState {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pluginId  String
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, pluginId])
  @@index([guildId])
}

model PluginConfig {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pluginId  String
  config    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, pluginId])
  @@index([guildId])
}

/// Global (not per-guild): records which plugin data-migrations have already run.
model PluginMigration {
  id          String   @id @default(cuid())
  pluginId    String
  migrationId String
  appliedAt   DateTime @default(now())

  @@unique([pluginId, migrationId])
}

// ---------------------------------------------------------------------------
// Users (global, not tenant-scoped)
// ---------------------------------------------------------------------------

model UserProfile {
  id         String    @id
  username   String?
  globalName String?
  avatarHash String?
  locale     String?
  timezone   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model ModerationCase {
  id            String             @id @default(cuid())
  guildId       String
  guild         Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  caseNumber    Int
  type          ModerationCaseType
  targetId      String
  moderatorId   String
  reason        String?
  evidenceUrls  String[]
  durationMs    Int?
  expiresAt     DateTime?
  expiredAt     DateTime?
  dmSent        Boolean            @default(false)
  metadata      Json?
  source        ActionSource
  automodRuleId String?
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  warnings        ModerationWarning[]
  appeals         ModerationAppeal[]
  enforcerRecords EnforcerRecord[]

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([guildId, targetId])
  @@index([guildId, moderatorId])
  @@index([guildId, type])
  @@index([expiresAt])
}

model ModerationWarning {
  id          String         @id @default(cuid())
  guildId     String
  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  caseId      String
  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderatorId String
  reason      String?
  active      Boolean        @default(true)
  clearedAt   DateTime?
  clearedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([guildId])
  @@index([guildId, userId, active])
}

/// Staff note text is intentionally stored here (unlike moderation evidence,
/// which is evidence-links-only per SPEC.md).
model ModerationNote {
  id        String    @id @default(cuid())
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  authorId  String
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([guildId])
  @@index([guildId, userId])
}

model ModerationAppeal {
  id               String          @id @default(cuid())
  guildId          String
  guild            Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  caseId           String?
  case             ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  userId           String
  content          String
  status           AppealStatus    @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  decisionNote     String?
  staffMessageId   String?
  // Set once `applyAppealDecisionEffects` has actually run for this appeal (DM sent, timeout reversed / unban
  // button posted, enforcer ledger entry emitted). Durable and permanent — unlike the old Redis
  // `appeal-applied` marker (30-day TTL), this can never silently expire and cause `appeal-sync` to re-apply
  // effects a second time.
  effectsAppliedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([guildId])
  @@index([guildId, status])
  @@index([status, effectsAppliedAt])
}

// ---------------------------------------------------------------------------
// Automod
// ---------------------------------------------------------------------------

model AutomodRule {
  id               String          @id @default(cuid())
  guildId          String
  guild            Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name             String
  type             AutomodRuleType
  enabled          Boolean         @default(true)
  dryRun           Boolean         @default(true)
  config           Json
  actions          Json
  exemptRoleIds    String[]
  exemptChannelIds String[]
  exemptUserIds    String[]
  trustedDomains   String[]
  cooldownSeconds  Int             @default(0)
  priority         Int             @default(0)
  deletedAt        DateTime?
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  events AutomodEvent[]

  @@index([guildId])
}

model AutomodEvent {
  id           String              @id @default(cuid())
  guildId      String
  guild        Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ruleId       String
  // Restrict (not cascade/setnull): rules are soft-deleted (`AutomodRule.deletedAt`)
  // rather than hard-deleted, so events always keep a live rule reference.
  rule         AutomodRule         @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleType     AutomodRuleType
  userId       String
  channelId    String?
  messageId    String?
  matched      String?
  actionsTaken Json
  dryRun       Boolean
  riskScore    Float?
  reviewStatus AutomodReviewStatus @default(NONE)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([guildId, reviewStatus])
}

// ---------------------------------------------------------------------------
// Audit + logging
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  guildId    String
  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId    String
  actorType  ActorType
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  source     AuditSource
  createdAt  DateTime    @default(now())

  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([guildId, action])
  @@index([guildId, actorId])
}

model LogEvent {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  kind      String
  actorId   String?
  targetId  String?
  channelId String?
  messageId String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, kind, createdAt])
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

model Ticket {
  id              String       @id @default(cuid())
  guildId         String
  guild           Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  number          Int
  openerId        String
  channelId       String?
  threadId        String?
  mode            TicketMode
  status          TicketStatus @default(OPEN)
  subject         String?
  intake          Json?
  tags            String[]
  assigneeId      String?
  panelId         String?
  closedAt        DateTime?
  closedBy        String?
  closeReason     String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  participants TicketParticipant[]
  transcript   TicketTranscript?

  @@unique([guildId, number])
  @@index([guildId])
  @@index([guildId, status])
}

model TicketParticipant {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  addedBy   String
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model TicketTranscript {
  id           String    @id @default(cuid())
  ticketId     String    @unique
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  htmlContent  String?
  jsonContent  Json?
  messageCount Int
  generatedAt  DateTime  @default(now())
  expiresAt    DateTime?
}

model TicketPanel {
  id             String     @id @default(cuid())
  guildId        String
  guild          Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId      String
  messageId      String?
  title          String
  description    String
  buttonLabel    String
  categoryId     String?
  supportRoleIds String[]
  mode           TicketMode
  intakeForm     Json?
  slaMinutes     Int?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([guildId])
}

// ---------------------------------------------------------------------------
// Role panels, onboarding, verification
// ---------------------------------------------------------------------------

model RolePanel {
  id            String         @id @default(cuid())
  guildId       String
  guild         Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId     String
  messageId     String?
  title         String
  description   String?
  style         RolePanelStyle
  groupId       String?
  maxSelections Int?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  options RolePanelOption[]

  @@index([guildId])
}

model RolePanelOption {
  id          String    @id @default(cuid())
  panelId     String
  panel       RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roleId      String
  label       String
  emoji       String?
  description String?
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([panelId])
}

model RoleGroup {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name          String
  roleIds       String[]
  maxSelections Int?
  exclusive     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId])
}

model MemberRoleSnapshot {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  roleIds   String[]
  leftAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
}

model VerificationRequest {
  id             String             @id @default(cuid())
  guildId        String
  guild          Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId         String
  answers        Json?
  method         VerificationMethod
  status         VerificationStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  staffMessageId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([guildId])
  @@index([guildId, status])
}

model OnboardingProgress {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId          String
  steps           Json
  rulesAcceptedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model ScheduledJob {
  id        String    @id @default(cuid())
  guildId   String?
  guild     Guild?    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pluginId  String
  type      String
  payload   Json
  runAt     DateTime
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  bullJobId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([guildId])
  @@index([status, runAt])
}

model Reminder {
  id          String    @id @default(cuid())
  guildId     String?
  guild       Guild?    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  channelId   String?
  content     String
  remindAt    DateTime
  recurring   String?
  delivered   Boolean   @default(false)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([guildId])
  @@index([remindAt, delivered])
}

model ScheduledAnnouncement {
  id        String    @id @default(cuid())
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  content   Json
  cron      String?
  runAt     DateTime?
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([guildId])
}

// ---------------------------------------------------------------------------
// Community / engagement
// ---------------------------------------------------------------------------

model Giveaway {
  id                String   @id @default(cuid())
  guildId           String
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId         String
  messageId         String?
  prize             String
  winnerCount       Int
  hostId            String
  endsAt            DateTime
  ended             Boolean  @default(false)
  requiredRoleIds   String[]
  minAccountAgeDays Int?
  minLevel          Int?
  winnerIds         String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries GiveawayEntry[]

  @@index([guildId])
  @@index([ended, endsAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@unique([giveawayId, userId])
}

model Poll {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String
  messageId   String?
  question    String
  anonymous   Boolean   @default(false)
  multiSelect Boolean   @default(false)
  endsAt      DateTime?
  closed      Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  options PollOption[]
  votes   PollVote[]

  @@index([guildId])
}

model PollOption {
  id       String  @id @default(cuid())
  pollId   String
  poll     Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  position Int
  emoji    String?

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@unique([pollId, optionId, userId])
}

model Suggestion {
  id        String           @id @default(cuid())
  guildId   String
  guild     Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  number    Int
  authorId  String
  channelId String
  messageId String?
  content   String
  status    SuggestionStatus @default(PENDING)
  staffNote String?
  threadId  String?
  upvotes   Int              @default(0)
  downvotes Int              @default(0)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  votes SuggestionVote[]

  @@unique([guildId, number])
  @@index([guildId])
}

model SuggestionVote {
  id           String     @id @default(cuid())
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  value        Int
  createdAt    DateTime   @default(now())

  @@unique([suggestionId, userId])
}

model StarboardEntry {
  id                 String   @id @default(cuid())
  guildId            String
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sourceMessageId    String   @unique
  sourceChannelId    String
  starboardMessageId String?
  authorId           String
  starCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([guildId])
}

model TempVoiceChannel {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String   @unique
  ownerId      String
  hubChannelId String
  createdAt    DateTime @default(now())

  @@index([guildId])
}

model CommunityEvent {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  channelId       String?
  messageId       String?
  hostId          String
  discordEventId  String?
  reminderMinutes Int[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rsvps EventRsvp[]

  @@index([guildId])
}

model EventRsvp {
  id        String         @id @default(cuid())
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  status    RsvpStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, userId])
}

/// Custom commands (`/tag show <name>`) and opt-in keyword auto-responders. Content is plain text or a flat
/// embed rendered with the welcome engine's fixed, non-recursive variable set — never a scripting language.
model Tag {
  id                String         @id @default(cuid())
  guildId           String
  guild             Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name              String // 1..32, lowercase [a-z0-9-_], unique per guild
  content           String? // plain text <= 2000, rendered with renderTemplate
  embed             Json? // EmbedBuilderPayload-shaped: { title, description, colorHex, imageUrl, footer }
  triggerMode       TagTriggerMode @default(NONE)
  trigger           String? // 2..100 chars; required when triggerMode != NONE
  triggerChannelIds String[]       @default([]) // empty = all channels
  staffOnly         Boolean        @default(false) // only helper+ can invoke /tag show <name>
  uses              Int            @default(0)
  createdBy         String
  updatedBy         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([guildId, name])
  @@index([guildId, triggerMode])
}

/**
 * One staff-authored message the bot keeps re-posting at the bottom of a channel (community sticky messages).
 * Stores only the text/embed staff wrote plus the id of the bot's own last post — never member messages.
 */
model StickyMessage {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId       String
  content         String?
  embed           Json?
  cooldownSeconds Int       @default(10)
  lastMessageId   String?
  lastPostedAt    DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

/// Member-shared birthday for the community plugin. Deliberately month + day only — no year, no age, ever.
/// One row per (guild, user); removed by the member (`/birthday remove`), by an admin, or with the guild's data.
model Birthday {
  id                String   @id @default(cuid())
  guildId           String
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId            String
  month             Int
  day               Int
  lastAnnouncedYear Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, month, day])
}

// ---------------------------------------------------------------------------
// Leveling, reputation, economy
// ---------------------------------------------------------------------------

model LevelProfile {
  id           String    @id @default(cuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId       String
  xp           Int       @default(0)
  level        Int       @default(0)
  messages     Int       @default(0)
  lastXpAt     DateTime?
  voiceMinutes Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
  @@index([guildId])
}

model LevelReward {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  level     Int
  roleId    String
  createdAt DateTime @default(now())

  @@unique([guildId, level, roleId])
  @@index([guildId])
}

model ReputationEvent {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  amount     Int
  reason     String?
  createdAt  DateTime @default(now())

  @@index([guildId])
  @@index([guildId, toUserId])
  @@index([guildId, fromUserId, createdAt])
}

/// Virtual currency only — no real-money functionality (SPEC.md §G). Balance is
/// a derived/cached total; EconomyTransaction is the append-only ledger.
model EconomyAccount {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  balance     BigInt    @default(0)
  lastDailyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions EconomyTransaction[]

  @@unique([guildId, userId])
  @@index([guildId])
}

model EconomyTransaction {
  id         String          @id @default(cuid())
  guildId    String
  guild      Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  accountId  String?
  account    EconomyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fromUserId String?
  toUserId   String?
  amount     BigInt
  type       String
  note       String?
  createdAt  DateTime        @default(now())

  @@index([guildId])
  @@index([guildId, createdAt])
}

model AfkStatus {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  message   String?
  since     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
}

// ---------------------------------------------------------------------------
// Integrations & webhooks
// ---------------------------------------------------------------------------

model IntegrationConnection {
  id                  String              @id @default(cuid())
  guildId             String
  guild               Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  provider            IntegrationProvider
  // A guild may have multiple connections of the same provider (e.g. several
  // Twitch alerts) — no @@unique([guildId, provider]); label disambiguates.
  label               String?
  status              ConnectionStatus    @default(PENDING)
  config              Json
  externalAccountId   String?
  externalAccountName String?
  lastSyncAt          DateTime?
  lastError           String?
  connectedBy         String
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  oauthToken        OAuthToken?
  twitchChatChannel TwitchChatChannel?

  @@index([guildId])
  @@index([guildId, provider])
}

model OAuthToken {
  id              String                @id @default(cuid())
  connectionId    String                @unique
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenType       String?
  scopes          String[]
  expiresAt       DateTime?
  rotatedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model WebhookEndpoint {
  id             String           @id @default(cuid())
  guildId        String
  guild          Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  direction      WebhookDirection
  provider       String?
  name           String
  url            String?
  secretEnc      String
  events         String[]
  channelId      String?
  enabled        Boolean          @default(true)
  lastDeliveryAt DateTime?
  failureCount   Int              @default(0)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  deliveries WebhookDelivery[]

  @@index([guildId])
}

model WebhookDelivery {
  id          String           @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  direction   WebhookDirection
  status      Int?
  success     Boolean
  attempt     Int              @default(1)
  error       String?
  payloadHash String?
  createdAt   DateTime         @default(now())

  @@index([endpointId, createdAt])
}

/// Idempotency guard for inbound provider webhooks.
model ProcessedWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Singleton (one row): Pavisie's own Twitch bot account, authorized once by the bot owner
/// (scopes `user:read:chat user:write:chat user:bot`). All chat reads/sends run on this token —
/// per-guild channels only grant the bot entry via `channel:bot` (see TwitchChatChannel).
model TwitchBotIdentity {
  id              String           @id @default(cuid())
  botUserId       String           @unique
  botLogin        String
  accessTokenEnc  String
  refreshTokenEnc String
  scopes          String[]
  expiresAt       DateTime
  status          ConnectionStatus @default(CONNECTED)
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// A guild's linked Twitch channel for the chat bot (dashboard "Connect Twitch channel").
model TwitchChatChannel {
  id                String                 @id @default(cuid())
  guildId           String
  guild             Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  broadcasterUserId String
  broadcasterLogin  String
  enabled           Boolean                @default(true)
  status            ConnectionStatus       @default(PENDING)
  lastError         String?
  lastConnectedAt   DateTime?
  commandPrefix     String                 @default("!")
  connectionId      String?                @unique
  connection        IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  // Channel-point rewards overlay (SPEC.md §J channel-points extension): the overlay browser-source URL's
  // capability token, encrypted at rest, and whether reward redemptions are turned on for this channel at all.
  overlayTokenEnc   String?
  rewardsEnabled    Boolean                @default(false)
  createdBy         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  commands TwitchChatCommand[]
  timers   TwitchChatTimer[]
  rewards  TwitchChatReward[]

  @@unique([guildId, broadcasterUserId])
  @@index([guildId])
}

/// Custom `!command` responses for a linked Twitch chat channel.
model TwitchChatCommand {
  id              String            @id @default(cuid())
  channelId       String
  channel         TwitchChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId         String
  guild           Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name            String
  response        String
  cooldownSeconds Int               @default(5)
  minLevel        TwitchChatLevel   @default(EVERYONE)
  enabled         Boolean           @default(true)
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([channelId, name])
  @@index([guildId])
}

/// Recurring auto-posted messages for a linked Twitch chat channel.
model TwitchChatTimer {
  id              String            @id @default(cuid())
  channelId       String
  channel         TwitchChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId         String
  guild           Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name            String
  message         String
  intervalMinutes Int
  enabled         Boolean           @default(true)
  lastFiredAt     DateTime?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([channelId, name])
  @@index([guildId])
}

/// Channel-point reward → overlay/chat/Discord action for a linked Twitch chat channel. Config rows key off
/// `channelId` (never `connectionId`) because re-linking replaces the `IntegrationConnection`/`OAuthToken`
/// but preserves the `TwitchChatChannel` row (docs/claude-project channel-points spec, binding fact 5).
model TwitchChatReward {
  id        String                 @id @default(cuid())
  channelId String
  channel   TwitchChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId   String
  guild     Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // Twitch custom reward id, when picked from the dashboard's "list rewards from Twitch" dropdown; null means
  // match redemptions by `rewardTitle` (case-insensitively) instead — e.g. for a reward created after this row.
  rewardId  String?
  rewardTitle String
  enabled   Boolean                @default(true)
  action    TwitchRewardActionKind

  // SOUND
  soundUrl String?
  volume   Int     @default(80)
  // TTS
  ttsTemplate String?
  // CHAT
  chatTemplate String?
  // DISCORD
  discordChannelId String?
  discordTemplate  String?

  // 0..3600, enforced in memory per reward (see rewards.ts) rather than here.
  cooldownSeconds Int      @default(0)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([channelId, rewardTitle, action])
  @@index([guildId])
  @@index([channelId])
}

// ---------------------------------------------------------------------------
// Privacy / retention
// ---------------------------------------------------------------------------

model DataRetentionPolicy {
  id                   String   @id @default(cuid())
  guildId              String   @unique
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  auditLogDays         Int      @default(365)
  logEventDays         Int      @default(90)
  moderationCaseDays   Int?
  automodEventDays     Int      @default(90)
  ticketTranscriptDays Int      @default(90)
  levelInactivityDays  Int?
  analyticsDays        Int      @default(365)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([guildId])
}

model DataRequest {
  id              String          @id @default(cuid())
  guildId         String
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type            DataRequestType
  status          JobStatus       @default(PENDING)
  requestedBy     String
  resultUrl       String?
  resultExpiresAt DateTime?
  error           String?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([guildId])
}

/**
 * Content for a completed EXPORT `DataRequest`, downloaded via `GET /guilds/:guildId/data/requests/:id/download`.
 * Kept separate from `DataRequest` (rather than a column there) since it can be large and most `DataRequest`
 * reads (list/status polling) have no reason to load it. Deleted along with the guild (cascade) — an export
 * blob has no reason to outlive the data it was generated from.
 */
model DataExportBlob {
  id        String   @id @default(cuid())
  requestId String   @unique
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([guildId])
}

// ---------------------------------------------------------------------------
// AI usage & analytics
// ---------------------------------------------------------------------------

model AiUsage {
  id               String   @id @default(cuid())
  guildId          String
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId           String
  command          String
  promptTokens     Int
  completionTokens Int
  provider         String
  model            String
  createdAt        DateTime @default(now())

  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
}

model GuildAnalyticsDaily {
  id                String   @id @default(cuid())
  guildId           String
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  joins             Int      @default(0)
  leaves            Int      @default(0)
  memberCount       Int?
  messages          Int      @default(0)
  moderationActions Int      @default(0)
  automodTriggers   Int      @default(0)
  ticketsOpened     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([guildId, date])
  @@index([guildId])
