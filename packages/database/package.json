{
  "name": "@pavisie/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "validate": "prisma validate",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "reencrypt:secrets": "tsx scripts/reencrypt-secrets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.js src prisma scripts",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@pavisie/types": "workspace:*",
    "@pavisie/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0",
    "vitest": "^3.0.0"
  }
}
