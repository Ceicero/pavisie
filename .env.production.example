# Pavisie — production environment configuration for the pavisie.com deployment.
# See docs/ARCHITECTURE.md §21 (cloud hosting) and §21a (production domain) for the full
# rationale. Copy to `.env` on the production host (or set these as platform env vars) and
# fill in every blank secret. Never commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database & cache — reference your host's managed Postgres/Redis, e.g. on
# Railway: ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}}.
# ---------------------------------------------------------------------------

DATABASE_URL=
REDIS_URL=

# ---------------------------------------------------------------------------
# Discord application
# ---------------------------------------------------------------------------

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://api.pavisie.com/auth/discord/callback

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------

ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# API, dashboard & website networking — canonical pavisie.com layout
# ---------------------------------------------------------------------------

# The per-guild config dashboard is served by `web` now (pavisie.com/dashboard/**) — the old
# app.pavisie.com app is a legacy-link redirector (soon: an owner-only ops console on a
# separate domain). DASHBOARD_URL below is therefore the same value as WEB_URL.
API_PORT=3001
API_BASE_URL=https://api.pavisie.com
DASHBOARD_URL=https://pavisie.com
NEXT_PUBLIC_API_URL=https://api.pavisie.com
WEB_URL=https://pavisie.com
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_INVITE_PERMISSIONS=

# Optional support Discord invite link — shown on the website (footer, /support) and the dashboard
# (sidebar, error states — both now part of `web`'s /dashboard/**) when set; hidden everywhere when
# blank. Set as a build-time var on `web`.
NEXT_PUBLIC_SUPPORT_SERVER_URL=

# `app.pavisie.com`'s redirector (still a separate deployable, `apps/dashboard`) reads
# NEXT_PUBLIC_API_URL (above) and WEB_URL (above, but read server-side there — see
# apps/dashboard/next.config.ts) to keep its restored session/theme wiring real and to know where
# to send its legacy `/` and `/dashboard/*` redirects. No dashboard-specific vars needed here.

# ---------------------------------------------------------------------------
# Cookies & CSRF — shared apex domain, no cross-site cookie mode needed
# ---------------------------------------------------------------------------

COOKIE_DOMAIN=.pavisie.com
SESSION_COOKIE_SAMESITE=lax
# Integer hop count, NOT a bare boolean: Railway/Render sit exactly one reverse proxy in front of `api`, so
# this must be `1`. `TRUST_PROXY=true` would trust the leftmost (attacker-controlled) X-Forwarded-For entry,
# letting a caller spoof a fresh IP per request to dodge rate limits; `false` would collapse every visitor
# onto the platform's proxy IP. See infra/DEPLOYMENT.md.
TRUST_PROXY=1
E2E_TEST_MODE=false

# ---------------------------------------------------------------------------
# Bot behavior
# ---------------------------------------------------------------------------

BOT_OWNER_IDS=
DEV_GUILD_ID=
BOT_HEALTH_PORT=3002
ENABLE_MESSAGE_CONTENT_INTENT=false
ENABLE_GUILD_MEMBERS_INTENT=true
ENABLE_GUILD_PRESENCES_INTENT=false

# ---------------------------------------------------------------------------
# Brand assets
# ---------------------------------------------------------------------------

BRAND_LOGO_PATH=/brand/pavisie-skull.png

# ---------------------------------------------------------------------------
# Donations — Ko-fi link-out. No Stripe involved; no payment processing.
# (The guild-facing Stripe integration connector was removed 2026-09-02 — see docs/ARCHITECTURE.md §18a.)
# ---------------------------------------------------------------------------

# Full Ko-fi page URL, e.g. https://ko-fi.com/yourname. When unset, donations are disabled and the
# /donate page shows a "not configured" notice.
KOFI_URL=

# ---------------------------------------------------------------------------
# Webhooks — public base for inbound EventSub/GitHub/generic deliveries
# ---------------------------------------------------------------------------

PUBLIC_WEBHOOK_BASE_URL=https://api.pavisie.com

# ---------------------------------------------------------------------------
# Optional — integrations & adapters (leave blank to keep disabled)
# ---------------------------------------------------------------------------

# Twitch — same vars power both stream-live alerts and the Twitch chat bot (dedicated bot account + per-guild
# channel:bot links, custom commands/timers over EventSub WebSocket + Helix). No separate chat-bot vars.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
YOUTUBE_API_KEY=
GITHUB_WEBHOOK_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
STEAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRANSLATE_PROVIDER=none
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
WEATHER_PROVIDER=none
OPENWEATHERMAP_API_KEY=
# Powers the roles plugin's optional CAPTCHA verification mode. Donations are handled externally by Ko-fi
# and do not require CAPTCHA here.
CAPTCHA_PROVIDER=none
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
MEDIA_PROVIDER=none
