# Pavisie environment configuration.
# Copy this file to `.env` in the repo root and fill in the values you need.
# All variables are read through `@pavisie/core` `env` (zod-validated). Only
# NODE_ENV/LOG_LEVEL are truly required to boot; each app validates the subset
# it actually needs at startup via `requireEnv()`.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Runtime mode. Read by: bot, api, dashboard.
NODE_ENV=development

# pino log level (trace|debug|info|warn|error|fatal). Read by: bot, api.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database & cache
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma. Read by: bot, api, database package (migrations/seed).
DATABASE_URL=postgresql://pavisie:pavisie@localhost:5432/pavisie

# Redis connection string used for cache, rate limiting, queues, sessions. Read by: bot, api.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Discord application
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal (Bot tab). Read by: bot (required); api (optional — powers the dashboard's
# channel/role pickers via GET /guilds/:id/discord/channels|roles; without it those endpoints return 503 and the
# dashboard falls back to raw id inputs). NEVER commit this.
DISCORD_TOKEN=

# Application/client id from the Discord Developer Portal (General Information tab). Read by: bot, api.
DISCORD_CLIENT_ID=

# Client secret from the Discord Developer Portal (General Information tab). Read by: api only (OAuth token exchange).
DISCORD_CLIENT_SECRET=

# OAuth2 redirect URI, must exactly match one registered in the Discord Developer Portal. Read by: api.
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32 bytes, base64-encoded, used for AES-256-GCM encryption of stored secrets (OAuth tokens, webhook secrets).
# Generate: openssl rand -base64 32
# Read by: core (crypto/encryption.ts), used by api, bot.
ENCRYPTION_KEY=

# Previous encryption key, kept temporarily during key rotation so old ciphertext can still be decrypted.
# Generate: openssl rand -base64 32 (this is the OLD key you are rotating away from, not a new one)
# Read by: core (crypto/encryption.ts), used by api, bot.
ENCRYPTION_KEY_PREVIOUS=

# Random string, at least 32 characters, used to sign session cookies.
# Generate: openssl rand -base64 32
# Read by: api.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# API & dashboard networking
# ---------------------------------------------------------------------------

# Port the Fastify API listens on. Read by: api.
API_PORT=3001

# Public base URL of the API, used to build OAuth callback/self-referencing links. Read by: api.
API_BASE_URL=http://localhost:3001

# Public base URL of the per-guild config dashboard, used for the CORS allowlist and post-OAuth
# redirects. The dashboard UI is served by the web app now (pavisie.com/dashboard/**, formerly
# its own app.pavisie.com app) — this equals WEB_URL below. Read by: api.
DASHBOARD_URL=http://localhost:3003

# Base URL the web app's browser code (marketing pages and the /dashboard/** config UI alike) uses
# to call the API. Must be prefixed NEXT_PUBLIC_ to reach the client bundle. Read by: web; also
# read by the dashboard app (its session/theme/UI wiring stays real for the ops console work ahead
# — see apps/dashboard's README) even though it has no routes using it yet.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public base URL of the marketing website (and, since the dashboard→web merge, the /dashboard/**
# config UI too). Used for the CORS allowlist, the donations success/cancel redirect URLs, as the
# brand icon base (embed author/footer icon) via core's brandIconUrl(), and as the redirect target
# for the legacy dashboard redirector app (see apps/dashboard/next.config.ts). Read by: api, web,
# bot, dashboard (server-side, its own redirects() — not a NEXT_PUBLIC_ var there).
WEB_URL=http://localhost:3003

NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_INVITE_PERMISSIONS=

# Optional public support/community Discord server invite link, e.g. https://discord.gg/xxxxxxxx. Shown on the
# website's footer/support page and the dashboard sidebar + error states (both now part of the web
# app's /dashboard/** — see apps/web's README); hidden everywhere when unset. Must be prefixed
# NEXT_PUBLIC_ to reach the client bundle. Read by: web.
NEXT_PUBLIC_SUPPORT_SERVER_URL=

# Optional. `next build` emits `output: 'standalone'` (what Dockerfile.dashboard consumes) by default on Linux/macOS,
# and skips it on Windows dev machines (standalone tracing needs symlink privileges there). Set true/false to force. Read by: dashboard build.
NEXT_OUTPUT_STANDALONE=

# Session cookie SameSite mode: lax|none. Use 'none' only when api/dashboard are on different eTLD+1 domains (e.g.
# separate PaaS subdomains); it forces the cookie Secure and the api refuses to start unless API_BASE_URL looks like
# https. Default 'lax' works for same-site/custom-domain deployments. Read by: api.
SESSION_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Optional — bot behavior
# ---------------------------------------------------------------------------

# Comma-separated Discord user IDs treated as bot owners (bot-owner-only commands, immune to moderation). Read by: bot, api.
BOT_OWNER_IDS=

# If set, `commands:register` registers slash commands to this guild only (instant) instead of globally (up to 1h propagation). Read by: bot.
DEV_GUILD_ID=

# off | global | guild — have the bot register its slash commands itself right after it logs in, so hosted
# deployments never need a local `commands:register` run. 'guild' targets DEV_GUILD_ID (instant); 'global' can take
# up to an hour to show up in Discord. Read by: bot.
REGISTER_COMMANDS_ON_BOOT=off

# Port for the bot's tiny HTTP /health endpoint, used by Docker healthchecks. Read by: bot.
BOT_HEALTH_PORT=3002

# Message command prefix (1–3 non-alphanumeric characters). Every slash command can also be invoked as `+commandname args`.
# For example, `/mod ban @user spam` becomes `+mod ban @user spam`. Slash commands continue to work unchanged.
# REQUIRES the Message Content Intent to be enabled in the Discord Developer Portal AND ENABLE_MESSAGE_CONTENT_INTENT=true below.
# Read by: bot.
COMMAND_PREFIX=+

# Enables the privileged Message Content intent. REQUIRED for the + prefix command layer, automod, Enforcer automatic
# flagging, and message logging. This is a privileged intent that must ALSO be switched on in the Discord Developer Portal:
# Applications → your app → Bot → Privileged Gateway Intents → Message Content Intent. Once a bot is in 100+ servers,
# Discord requires formal approval to use this intent (applies only at that scale; under 100 servers it works immediately
# once you toggle it). Without this enabled in BOTH places, +prefix commands, automod, Enforcer automatic flagging, and
# message logging will silently no-op — they do nothing at all if the intent is not available. Read by: bot.
ENABLE_MESSAGE_CONTENT_INTENT=true

# Enables the privileged Guild Members intent, needed for joins/leaves, welcome messages, raid detection, role persistence. Read by: bot.
ENABLE_GUILD_MEMBERS_INTENT=true

# Enables the privileged Guild Presences intent. Not used by default features. Read by: bot.
ENABLE_GUILD_PRESENCES_INTENT=false

# ---------------------------------------------------------------------------
# Optional — cookies & proxying
# ---------------------------------------------------------------------------

# Shared parent domain for api+dashboard cookies in production (e.g. ".example.com"). Leave unset in local dev. Read by: api.
COOKIE_DOMAIN=

# Number of reverse-proxy hops in front of the api process, so Fastify trusts X-Forwarded-* headers and reads
# the real client IP from the correct position (used for rate limiting). Takes an integer hop count, not just a boolean:
# `false` (default, correct for local dev with no proxy) trusts nothing and collapses every caller onto one IP;
# a bare `true` trusts the LEFTMOST X-Forwarded-For entry, which the client fully controls, so a caller can spoof
# a fresh IP per request to dodge per-IP rate limits — never use `true` in production. Set to the exact hop count
# in production (`1` behind Railway/Render's single edge proxy). See infra/DEPLOYMENT.md. Read by: api.
TRUST_PROXY=false

# Enables POST /auth/test-login for Playwright e2e tests. The api refuses this route whenever NODE_ENV=production, regardless of this flag. Read by: api.
E2E_TEST_MODE=false

# ---------------------------------------------------------------------------
# Optional — integrations & adapters (features self-disable when unset)
# ---------------------------------------------------------------------------

# Twitch application credentials for stream-live alerts AND the Twitch chat bot (a dedicated bot account +
# per-guild "channel:bot" links, custom commands/timers) via the Twitch API/EventSub. Same vars for both
# features — no separate chat-bot vars. Read by: bot, api.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Signing secret for verifying inbound Twitch EventSub webhook deliveries. Read by: api.
TWITCH_EVENTSUB_SECRET=

# YouTube Data API key for upload/live alerts. Read by: bot.
YOUTUBE_API_KEY=

# Shared secret configured on your GitHub webhook, used to verify inbound deliveries. Generate: openssl rand -hex 32. Read by: api.
GITHUB_WEBHOOK_SECRET=

# Reddit application credentials for approved API integration. Read by: bot, api.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent string per their API rules, e.g. "pavisie-bot/0.1 by <reddit-username>". Read by: bot, api.
REDDIT_USER_AGENT=

# Steam Web API key for publicly available game/server status lookups. Read by: bot.
STEAM_API_KEY=

# Google OAuth client credentials for Google Calendar integration. Read by: api.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure AD) app credentials for Microsoft 365 Calendar integration. Read by: api.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Instagram OAuth (Instagram API with Instagram Login) app credentials — own-account-only connect, so the
# server only ever reads the media of whichever Instagram account authorizes it. Read by: api.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# AI provider API keys for the opt-in AI assistant plugin. Read by: bot, api.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which translation provider `/utility translate` uses (none|deepl|libretranslate). Read by: bot.
TRANSLATE_PROVIDER=none
# DeepL API key, required when TRANSLATE_PROVIDER=deepl. Read by: bot.
DEEPL_API_KEY=
# Self-hosted or public LibreTranslate instance URL, required when TRANSLATE_PROVIDER=libretranslate. Read by: bot.
LIBRETRANSLATE_URL=
# LibreTranslate API key, if your instance requires one. Read by: bot.
LIBRETRANSLATE_API_KEY=

# Which weather provider `/utility weather` uses (none|openweathermap|open-meteo). open-meteo needs no key. Read by: bot.
WEATHER_PROVIDER=none
# OpenWeatherMap API key, required when WEATHER_PROVIDER=openweathermap. Read by: bot.
OPENWEATHERMAP_API_KEY=

# Which CAPTCHA provider the verification flow uses (none|hcaptcha|turnstile). Powers the roles plugin's
# optional CAPTCHA verification mode. Donations are handled externally by Ko-fi and do not require CAPTCHA here.
# Read by: dashboard, api.
CAPTCHA_PROVIDER=none
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Compliant audio/streaming provider id for the music plugin. Plugin is unavailable when unset. Read by: bot.
MEDIA_PROVIDER=none

# Public HTTPS base URL used to build inbound webhook endpoints (Twitch EventSub, generic webhooks). Read by: api.
PUBLIC_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Optional — donations (apps/web + apps/api). The donate page links to Ko-fi (a third-party donation
# platform) when this is set, or says "donations aren't set up on this deployment" when unset. See
# docs/ARCHITECTURE.md §18. Read by: api.
# ---------------------------------------------------------------------------

# Full Ko-fi page URL, e.g. https://ko-fi.com/yourname. When unset, donations are disabled and the
# /donate page shows a "not configured" notice instead of failing. Read by: api.
KOFI_URL=

# ---------------------------------------------------------------------------
# Optional — brand assets
# ---------------------------------------------------------------------------

# Path (under WEB_URL) to the brand logo used as the Discord embed author/footer icon, e.g. "/brand/pavisie-skull.png".
# Defaults to /brand/pavisie-skull.png when unset. See scripts/sync-brand.mjs and docs/ARCHITECTURE.md §22. Read by: bot.
BRAND_LOGO_PATH=
