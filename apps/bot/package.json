{
  "name": "@pavisie/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "register": "tsx src/register.ts",
    "set-avatar": "tsx src/set-avatar.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.js src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1",
    "@pavisie/core": "workspace:*",
    "@pavisie/database": "workspace:*",
    "@pavisie/plugins": "workspace:*",
    "@pavisie/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0",
    "ioredis-mock": "^8.9.0"
  }
}
